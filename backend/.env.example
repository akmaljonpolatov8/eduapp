# ================================
# SERVER
# ================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ================================
# DATABASE
# ================================
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/educenter_db

# ================================
# REDIS
# ================================
REDIS_URL=redis://localhost:6379

# ================================
# JWT
# ================================
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_secret_change_this

# ================================
# AI — ANTHROPIC
# ================================
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_HEAVY=claude-sonnet-4-20250514     # Homework tekshiruv
AI_MODEL_LIGHT=claude-haiku-4-5-20251001    # Quick test, SMS

# ================================
# SMS — TEXTUP.UZ
# ================================
TEXTUP_API_KEY=your_textup_api_key
TEXTUP_SENDER_NAME=EduCenter

# ================================
# FILE STORAGE
# ================================
STORAGE_PROVIDER=s3               # s3 yoki cloudflare
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
AWS_BUCKET_NAME=educenter-uploads

# ================================
# LIMITS
# ================================
MAX_FILE_SIZE_MB=10
AI_MONTHLY_LIMIT_STARTER=500
AI_MONTHLY_LIMIT_PRO=2000
AI_MONTHLY_LIMIT_ENTERPRISE=99999
